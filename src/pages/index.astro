---
import { getCollection, getEntry } from 'astro:content';
import CTAButton from '../components/CTAButton.astro';
import DevlogCard from '../components/DevlogCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import SectionPanel from '../components/SectionPanel.astro';
import TagPill from '../components/TagPill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const home = await getEntry('home', 'home');
const latestPosts = (await getCollection('devlog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<BaseLayout
  title={home?.data.seo_title ?? 'Voidless Tale'}
  description={home?.data.description ?? 'Voidless Tale dark fantasy RPG and development updates.'}
>
  <SectionPanel>
    <h1>{home?.data.about_title ?? 'About Voidless Tale'}</h1>
    <p>{home?.data.about_text ?? home?.data.intro}</p>
  </SectionPanel>

  <section class="feature-grid">
    {(home?.data.feature_cards ?? []).map((card) => (
      <FeatureCard title={card.title} text={card.text} />
    ))}
  </section>

  <SectionPanel>
    <h2>{home?.data.media_title ?? 'Screenshot Preview'}</h2>
    <MediaPlaceholder image="/uploads/hero_img.png" alt="Voidless Tale preview" label="Voidless Tale" />
  </SectionPanel>

  <SectionPanel>
    <p class="kicker">{home?.data.latest_section_eyebrow ?? 'Latest Devlog'}</p>
    <h2>{home?.data.latest_section_title ?? 'Recent devlog posts'}</h2>
    <div class="devlog-grid">
      {latestPosts.map((post) => (
        <DevlogCard
          href={`/devlog/${post.id}/`}
          title={post.data.title}
          date={post.data.pubDate}
          excerpt={post.data.description}
          tags={post.data.tags ?? []}
        />
      ))}
    </div>
  </SectionPanel>

  <SectionPanel>
    <h2>{home?.data.cta_panel_title ?? 'Follow Development'}</h2>
    <p>{home?.data.cta_panel_text ?? 'Track progress through regular devlog updates and milestone posts.'}</p>
    <div class="tag-row">
      <TagPill label="Pixel RPG" />
      <TagPill label="Godot" />
      <TagPill label="C#" />
      <TagPill label="Solo Dev" />
      <TagPill label="In Development" />
    </div>
    <div class="cta-row">
      <CTAButton href={home?.data.primary_cta_href ?? '/devlog/'}>{home?.data.primary_cta_label ?? 'Read Devlog'}</CTAButton>
      <CTAButton href={home?.data.secondary_cta_href ?? '/about/'} variant="ghost">{home?.data.secondary_cta_label ?? 'About the project'}</CTAButton>
    </div>
  </SectionPanel>
</BaseLayout>
