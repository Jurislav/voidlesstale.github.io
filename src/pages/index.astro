---
import { getCollection, getEntry } from 'astro:content';
import CTAButton from '../components/CTAButton.astro';
import DevlogCard from '../components/DevlogCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import SectionPanel from '../components/SectionPanel.astro';
import TagPill from '../components/TagPill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const home = await getEntry('home', 'home');
const posts = (await getCollection('devlog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const panels = home?.data.panels ?? [];
---
<BaseLayout
  title={home?.data.seo_title ?? 'Voidless Tale'}
  description={home?.data.description ?? 'Voidless Tale dark fantasy RPG and development updates.'}
>
  {panels.map((panel) => {
    if (panel.type === 'features') {
      return (
        <section>
          {panel.eyebrow && <p class="kicker">{panel.eyebrow}</p>}
          {panel.title && <h2>{panel.title}</h2>}
          <div class="panel-grid" style={`--panel-columns: ${panel.columns}`}>
            {panel.cards.map((card) => <FeatureCard title={card.title} text={card.text} />)}
          </div>
        </section>
      );
    }

    if (panel.type === 'media') {
      return (
        <SectionPanel>
          <h2>{panel.title}</h2>
          <MediaPlaceholder image={panel.image} alt={panel.alt ?? ''} label={panel.label ?? 'Preview'} />
        </SectionPanel>
      );
    }

    if (panel.type === 'devlog') {
      return (
        <SectionPanel>
          {panel.eyebrow && <p class="kicker">{panel.eyebrow}</p>}
          <h2>{panel.title}</h2>
          <div class="panel-grid" style={`--panel-columns: ${panel.columns}`}>
            {posts.slice(0, panel.post_count).map((post) => (
              <DevlogCard
                href={`/devlog/${post.id}/`}
                title={post.data.title}
                date={post.data.pubDate}
                excerpt={post.data.description}
                tags={post.data.tags ?? []}
              />
            ))}
          </div>
        </SectionPanel>
      );
    }

    return (
      <SectionPanel variant={panel.type === 'cta' ? 'cta' : 'default'}>
        {panel.eyebrow && <p class="kicker">{panel.eyebrow}</p>}
        {panel.type === 'hero' ? <h1>{panel.title}</h1> : <h2>{panel.title}</h2>}
        <p>{panel.text}</p>
        {(panel.tags?.length ?? 0) > 0 && (
          <div class="tag-row">{panel.tags?.map((tag) => <TagPill label={tag} />)}</div>
        )}
        {(panel.buttons?.length ?? 0) > 0 && (
          <div class="cta-row">
            {panel.buttons?.map((button) => (
              <CTAButton href={button.href} variant={button.variant}>{button.label}</CTAButton>
            ))}
          </div>
        )}
      </SectionPanel>
    );
  })}
</BaseLayout>
