---
import { getCollection, getEntry, render } from 'astro:content';
import CTAButton from '../components/CTAButton.astro';
import FeatureCard from '../components/FeatureCard.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const smith = await getEntry('site', 'smith');
const sidebarPanels = (await getCollection('smithSidebar', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const renderedSidebarPanels = await Promise.all(
  sidebarPanels.map(async (panel) => ({
    panel,
    rendered: await render(panel),
  })),
);
---
<BaseLayout title={smith?.data.title ?? 'Voidless Smith'}>
  <section class="split-layout split-layout--compact smith-layout">
    <div class="stack-compact">
      <section class="panel">
        <h1>{smith?.data.title ?? 'Voidless Smith'}</h1>
        <p>{smith?.data.intro}</p>
        <CTAButton href={smith?.data.primary_cta_href ?? 'https://voidlesstale.itch.io/voidless-smith'}>
          {smith?.data.primary_cta_label ?? 'View on itch.io'}
        </CTAButton>
      </section>
      <MediaPlaceholder label={smith?.data.media_label ?? 'Tool Preview'} />
      <section class="feature-grid">
        {(smith?.data.feature_cards ?? []).map((card) => (
          <FeatureCard title={card.title} text={card.text} />
        ))}
      </section>
    </div>
    <aside class="smith-sidebar-stack">
      {renderedSidebarPanels.map(({ panel, rendered }) => {
        const { Content } = rendered;
        return (
          <section class="panel sidebar-panel">
            <h3>{panel.data.title}</h3>
            <Content />
          </section>
        );
      })}
    </aside>
  </section>
</BaseLayout>
